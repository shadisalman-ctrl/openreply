# Copy to the repository's .env. Fill in these account-specific values.
NEXTAUTH_URL=https://YOUR_ASSIGNED_DOMAIN.ngrok-free.app
NGROK_AUTHTOKEN=YOUR_NGROK_TOKEN
AUTH_MODE=admin
ADMIN_USERNAME=admin
# Choose a unique password of at least 16 characters. Keep it quoted.
ADMIN_PASSWORD="YOUR_STRONG_ADMIN_PASSWORD"

# Fill these before connecting Instagram. Dashboard setup can proceed without them.
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_SECRET=

# Leave blank: the installer generates these once and preserves them on reruns.
NEXTAUTH_SECRET=
CRON_SECRET=
ENCRYPTION_KEY=
WEBHOOK_VERIFY_TOKEN=
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379
